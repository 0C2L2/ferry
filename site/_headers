/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://api.ferryapp.download; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/downloads/*
  Content-Disposition: attachment
