# Ferry server config. Copy to .env and fill in.

PORT=8787

# --- Ferry Cloud Backup (managed; paid per company/business-model.md) ---
# Ferry's OWN Backblaze B2 account. This is the account-level MASTER key
# (needs the writeKeys capability to mint disposable per-backup keys) — it
# never leaves this server, never goes into the desktop app. See README.md.
B2_MASTER_KEY_ID=
B2_MASTER_APPLICATION_KEY=
B2_BUCKET_NAME=
