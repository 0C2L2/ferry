# Ferry Assist server config. Copy to .env and fill in.

PORT=8787

# Publicly reachable address of THIS server (an IP for an A record, or a
# hostname for a CNAME) — DNSimple points each new backup subdomain here.
PUBLIC_HOST=
DNSIMPLE_RECORD_TYPE=A

# --- Daytona (sandbox verification of AI-suggested install commands) ---
# https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# --- Nosana (decentralized LLM inference) ---
# Deploy a model template (e.g. an Ollama/vLLM image) from the Nosana
# dashboard, export its job definition JSON, and save it as
# nosana-job-definition.json in this directory. See README.md.
NOSANA_MARKET=
NOSANA_JOB_DEFINITION_PATH=./nosana-job-definition.json
NOSANA_MODEL=default

# --- DNSimple (share-link subdomain provisioning) ---
DNSIMPLE_API_TOKEN=
DNSIMPLE_ACCOUNT_ID=
# A domain already in this DNSimple account, with a wildcard TLS cert
# (*.DNSIMPLE_DOMAIN) provisioned ahead of time — see README.md.
DNSIMPLE_DOMAIN=

# --- Ferry Cloud Backup (managed, free-to-user) ---
# Ferry's OWN Backblaze B2 account. This is the account-level MASTER key
# (needs the writeKeys capability to mint disposable per-backup keys) — it
# never leaves this server, never goes into the desktop app. See README.md.
B2_MASTER_KEY_ID=
B2_MASTER_APPLICATION_KEY=
B2_BUCKET_NAME=
